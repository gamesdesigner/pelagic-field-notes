{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --config vite.vercel.config.ts",
    "build": "vite build --config vite.vercel.config.ts",
    "build:netlify": "vite build --config vite.netlify.config.ts",
    "dev:netlify": "vite --config vite.netlify.config.ts",
    "test:accounts": "node --test tests/accounts.test.mjs tests/owner-accounts.test.mjs tests/vercel-accounts.test.mjs tests/learning-progress.test.mjs tests/plankton-model.test.mjs tests/curriculum.test.mjs tests/written-quizzes.test.mjs",
    "typecheck:netlify": "tsc -p tsconfig.netlify.json",
    "start": "vite preview --config vite.vercel.config.ts",
    "test": "node --test tests/accounts.test.mjs tests/owner-accounts.test.mjs tests/vercel-accounts.test.mjs tests/learning-progress.test.mjs tests/plankton-model.test.mjs tests/curriculum.test.mjs tests/written-quizzes.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "build:vercel": "vite build --config vite.vercel.config.ts",
    "dev:vercel": "vite --config vite.vercel.config.ts",
    "typecheck:vercel": "tsc -p tsconfig.vercel.json"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.4",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.1",
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
